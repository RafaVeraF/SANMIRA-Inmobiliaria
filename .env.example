# Copia este archivo como .env y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API). La "anon key" es pública; NUNCA pongas aquí la service_role key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Teléfono de WhatsApp para el botón de contacto (formato internacional sin +)
VITE_WHATSAPP=524420000000
